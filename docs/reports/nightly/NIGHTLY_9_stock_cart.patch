diff --git a/frontend-nextjs/lib/orders/stock.ts b/frontend-nextjs/lib/orders/stock.ts
new file mode 100644
index 0000000..4b5d2b3
--- /dev/null
+++ b/frontend-nextjs/lib/orders/stock.ts
@@ -0,0 +1,17 @@
+import type { MenuItem } from '@/lib/db/schema'
+
+export type StockedItem = Pick<MenuItem, 'id' | 'name' | 'kind' | 'inStock' | 'stockQty'>
+
+export type StockShortage = { kind: 'unavailable' } | { kind: 'short'; name: string; left: number }
+
+// The storefront hides an item once its stock reaches 0, and Java refuses to sell more than is
+// left (BR-11); an order recorded here follows the same rule instead of clamping stock at 0.
+export function stockShortage(quantities: Map<number, number>, menu: StockedItem[]): StockShortage | null {
+  const byId = new Map(menu.map((item) => [item.id, item]))
+  for (const [id, qty] of quantities) {
+    const item = byId.get(id)
+    if (!item || item.kind !== 'menu' || !item.inStock || item.stockQty <= 0) return { kind: 'unavailable' }
+    if (item.stockQty < qty) return { kind: 'short', name: item.name, left: Math.floor(item.stockQty) }
+  }
+  return null
+}
